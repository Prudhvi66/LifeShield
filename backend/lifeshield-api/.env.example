# LifeShield Backend Configuration

# General
APP_NAME=LifeShield API
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["*"]

# Database (PostgreSQL URL for production, SQLite default for local dev)
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/lifeshield_db
DATABASE_URL=sqlite:///./lifeshield.db

# Authentication Security (JWT)
# Generate secret with: openssl rand -hex 32
JWT_SECRET_KEY=lifeshield_super_secure_jwt_secret_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Telephony Provider (Twilio - Optional)
# If left empty, SOS events are recorded and run in transparent simulated mode
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AI Provider (Optional: GEMINI_API_KEY, OPENAI_API_KEY)
# If left empty, the clinical safety reasoning engine handles questions securely
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Weather & Environment
# Open-Meteo is free and requires no API key.
# Optional OpenWeatherMap key if preferred:
OPENWEATHER_API_KEY=
